        "a=10 #global var\n",
        "b=20 #global var\n",
        "print(a,b)\n",
        "def func():\n",
        "  c=100 #local\n",
        "  global a #to change the value of global variable\n",
        "  a=110\n",
        "  print(c)\n",
        "  print(a,b)\n",
        "func()\n",
        "print(a,b)\n",
        "\n",
        "\n"
      ],
